# ─────────────────────────────────────────────────────────────────────────────
# Trestle environment. Copy to apps/web/.env.local (app) and export for the relayer/seed.
# NEVER commit real secrets. Values below are local-dev defaults or placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# local = two Anvil chains (31337 / 31338); testnet = Ethereum Sepolia + Base Sepolia
NETWORK_MODE=local
APP_URL=http://localhost:3000

# Postgres (docker compose / Render). Prisma reads DATABASE_URL.
DATABASE_URL=postgresql://trestle:trestle@localhost:5432/trestle

# Redis: either a TCP URL (docker compose) or Upstash REST credentials (Vercel/Render).
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Session signing secret for SIWE sessions (>= 32 chars in production). Generate: openssl rand -hex 32
SIWE_SECRET=

# Shared secret between the relayer worker and /api/webhooks/chain-events (>= 32 chars)
RELAYER_WEBHOOK_SECRET=

# ── Chains ──────────────────────────────────────────────────────────────────
# local mode
CHAIN_A_RPC_URL=http://127.0.0.1:8545
CHAIN_B_RPC_URL=http://127.0.0.1:8546
# testnet mode (server-side; may contain provider API keys)
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
# browser-visible RPCs (no secrets!). Default to public endpoints in testnet mode.
PUBLIC_CHAIN_A_RPC_URL=
PUBLIC_CHAIN_B_RPC_URL=
# optional: enables WalletConnect/MetaMask mobile in RainbowKit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Keys (testnet: fund on BOTH chains; local mode falls back to public Anvil dev keys) ──
# Deploys contracts (packages/contracts/script/deploy-*.sh)
DEPLOYER_PRIVATE_KEY=
# Relayer/solver wallet (fulfils intents, holds destination liquidity) — Render worker
RELAYER_PRIVATE_KEY=
# Attestation committee key (defaults to RELAYER_PRIVATE_KEY)
ATTESTER_PRIVATE_KEY=
# ERC-4337 bundler key used by the app to submit sponsored UserOperations (alias: PAYMASTER_PRIVATE_KEY)
BUNDLER_PRIVATE_KEY=
# Contract verification during testnet deploys (optional)
ETHERSCAN_API_KEY=
# Admin/arbiter wallet granted ARBITER_ROLE + authenticity admin at deploy (defaults to deployer)
ARBITER_ADDRESS=

# ── Economics (demo) ───────────────────────────────────────────────────────
PRICE_ETH_USD=3000
PROTOCOL_FEE_BPS=100
SOLVER_SPREAD_BPS=10
DELIVERY_WINDOW_DAYS=14

# ── Relayer worker ─────────────────────────────────────────────────────────
# direct = apply events to DATABASE_URL in-process; webhook = POST to RELAYER_WEBHOOK_URL
RELAYER_SYNC_MODE=direct
RELAYER_WEBHOOK_URL=
RELAYER_POLL_MS=
RELAYER_MAX_BLOCK_RANGE=
LOG_LEVEL=info

# ── Seeding testnet (optional) ─────────────────────────────────────────────
SEED_ADMIN_ADDRESS=
SEED_SELLER_ADDRESSES=
SEED_BUYER_ADDRESSES=
