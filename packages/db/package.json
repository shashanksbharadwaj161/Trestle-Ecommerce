{
  "name": "@trestle/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sync": "./src/sync/index.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx seed.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx seed.ts",
    "studio": "prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "prisma generate",
    "seed:catalog": "tsx seed.ts --catalog",
    "migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@trestle/shared": "workspace:*",
    "viem": "^2.40.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
