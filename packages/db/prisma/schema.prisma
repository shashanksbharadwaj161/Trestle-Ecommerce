// Trestle data model. Money is never stored as floats:
//  * fiat prices are integer micro-USD (BigInt, 1e-6 USD)
//  * on-chain token amounts are exact uint256 values (Decimal(78,0))

generator client {
  provider      = "prisma-client-js"
  // native (local), Vercel (Amazon Linux 2023) and Render (Debian) runtimes
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  /// runtime connection. On Supabase: the transaction pooler (port 6543) with
  /// ?pgbouncer=true&connection_limit=1&schema=trestle — see docs/CONNECTION_HANDOFF.md
  url       = env("DATABASE_URL")
  /// migrations only. On Supabase: the session pooler (port 5432) or direct connection, same ?schema=trestle
  directUrl = env("DIRECT_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  ESCROWED
  /// card orders only: payment confirmed by a signed Stripe webhook, being prepared
  PROCESSING
  SHIPPED
  DELIVERED
  DISPUTED
  COMPLETED
  REFUNDED
  CANCELLED
}

enum IntentStatus {
  CREATED
  ROUTING
  FULFILLED
  FAILED
}

enum RouteKind {
  DIRECT
  CROSS_CHAIN
}

enum DisputeStatus {
  OPEN
  RESOLVED
  WITHDRAWN
}

enum ReputationEventType {
  PURCHASE_COMPLETED
  SALE_COMPLETED
  AUTO_RELEASED
  DISPUTE_WON
  DISPUTE_LOST
  DISPUTE_SPLIT
  SELLER_REFUNDED
}

enum LoyaltyTxType {
  EARNED
  STAKED
  UNSTAKED
  CLAIMED
  REDEEMED
}

enum PaymentMethod {
  CRYPTO
  CARD
}

/// Fiat (card) payment lifecycle, deliberately separate from on-chain escrow state.
enum CardPaymentStatus {
  /// Checkout Session created; buyer has not paid
  OPEN
  /// session completed with a delayed payment method; awaiting async result
  PROCESSING
  PAID
  FAILED
  /// session expired or was expired by us; stock released
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum ShipmentCarrier {
  UPS
  USPS
  FEDEX
  DHL
  OTHER
}

model User {
  id                   String    @id @default(cuid())
  /// lower-cased EOA address proven via SIWE; null for email-only accounts
  walletAddress        String?   @unique
  displayName          String?
  /// lower-cased; unique among accounts that set a password. Never used on its own to link identities.
  email                String?   @unique
  /// scrypt hash (see apps/web/src/server/password.ts); null for wallet-only accounts
  passwordHash         String?
  emailVerifiedAt      DateTime?
  /// sessions issued before this instant are rejected (set on password change/reset)
  passwordChangedAt    DateTime?
  role                 Role      @default(BUYER)
  /// cached decayed on-chain reputation score (whole points) from the latest ReputationEventRecorded
  reputationScoreCache Decimal?  @db.Decimal(38, 6)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  seller              Seller?
  smartAccounts       SmartAccount[]
  orders              Order[]              @relation("BuyerOrders")
  disputesRaised      Dispute[]            @relation("DisputeRaisedBy")
  disputesResolved    Dispute[]            @relation("DisputeResolvedBy")
  reviews             Review[]
  reputationEvents    ReputationEvent[]
  loyaltyTransactions LoyaltyTransaction[]
  auditLogs           AuditLog[]
  wishlist            WishlistItem[]
  cardPayments        CardPayment[]
  returnRequests      ReturnRequest[]
  passwordResetTokens PasswordResetToken[]
}

/// Counterfactual ERC-4337 SimpleAccount owned by the user's EOA on a given chain.
model SmartAccount {
  id        String   @id @default(cuid())
  userId    String
  chainId   Int
  address   String
  factory   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chainId])
  @@unique([chainId, address])
}

model Seller {
  id             String    @id @default(cuid())
  userId         String    @unique
  storefrontName String
  slug           String    @unique
  bio            String    @default("")
  avatarUrl      String?
  bannerUrl      String?
  payoutChainId  Int
  /// token contract address (stablecoin) on payoutChainId
  payoutToken    String
  /// lower-cased address that receives escrow releases (defaults to the seller's wallet)
  payoutAddress  String
  verified       Boolean   @default(false)
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  orders   Order[]
}

model Product {
  id                  String        @id @default(cuid())
  sellerId            String
  title               String
  description         String
  images              String[]
  priceUsdMicros      BigInt
  currency            String        @default("USD")
  category            String
  /// chain ids buyers may pay from
  chainListingOptions Int[]
  status              ProductStatus @default(ACTIVE)
  featured            Boolean       @default(false)
  manufacturer        String?
  /// URL slug; unique when set
  slug                String?       @unique
  /// "women" | "men" | "unisex"
  department          String?
  /// e.g. "Midi dresses", "Straight jeans"
  subcategory         String?
  /// fibre composition shown on the product page, e.g. "100% cotton"
  material            String?
  /// fit notes, e.g. "Relaxed fit. True to size."
  fit                 String?
  care                String[]      @default([])
  /// key into the size charts in @trestle/shared (apparel.ts)
  sizeChartKey        String?
  /// products published after this date are listed under New arrivals
  publishedAt         DateTime      @default(now())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  seller       Seller                    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  variants     ProductVariant[]
  certificates AuthenticityCertificate[]
  orderItems   OrderItem[]
  reviews      Review[]
  gallery      ProductImage[]
  collections  CollectionProduct[]
  wishlistedBy WishlistItem[]

  @@index([status, featured])
  @@index([category, status])
  @@index([department, status])
  @@index([sellerId])
}

/// Ordered product photography with per-colour association and rights metadata.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String
  /// colour name this image depicts (matches ProductVariant.colour); null = all colours
  colour    String?
  position  Int      @default(0)
  width     Int?
  height    Int?
  /// e.g. "Sylius demo fixtures"
  credit    String?
  license   String?
  sourceUrl String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  /// hero image path
  image       String?
  position    Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  name       String
  attributes Json     @default("{}")
  sku        String   @unique
  stock      Int      @default(0)
  /// apparel option values (also mirrored in attributes)
  size       String?
  colour     String?
  colourHex  String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model AuthenticityCertificate {
  id              String   @id @default(cuid())
  productId       String
  tokenId         String
  contractAddress String
  chainId         Int
  mintTxHash      String   @unique
  minter          String
  ownerAddress    String
  manufacturer    String?
  batch           String?
  metadataUri     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([chainId, contractAddress, tokenId])
  @@index([productId])
}

model Order {
  id                    String           @id @default(cuid())
  /// null for guest card orders (access is via CardPayment.guestAccessTokenHash)
  buyerId               String?
  sellerId              String
  paymentMethod         PaymentMethod    @default(CRYPTO)
  cardPaymentId         String?
  status                OrderStatus      @default(PENDING_PAYMENT)
  subtotalUsdMicros     BigInt
  /// crypto orders only
  payoutChainId         Int?
  payoutToken           String?
  payoutAmount          Decimal?         @db.Decimal(78, 0)
  /// crypto orders: keccak256("trestle:order:" + id) — links on-chain intents/escrows to this row
  onchainRef            String?          @unique
  escrowChainId         Int?
  escrowContractOrderId String?
  /// escrow buyer identity (EOA or ERC-4337 smart account) on the escrow chain
  buyerAccount          String?
  deliveryDeadline      DateTime?
  shippingAddress       Json?
  trackingNumber        String?
  carrier               ShipmentCarrier?
  trackingUrl           String?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  completedAt           DateTime?
  /// stock is held for PENDING_PAYMENT orders until this time
  reservationExpiresAt  DateTime?
  stockReleased         Boolean          @default(false)
  /// true for seeded demo rows that have no on-chain counterpart
  isSeedDemo            Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  buyer          User?           @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller         Seller          @relation(fields: [sellerId], references: [id])
  cardPayment    CardPayment?    @relation(fields: [cardPaymentId], references: [id])
  items          OrderItem[]
  paymentIntents PaymentIntent[]
  dispute        Dispute?
  review         Review?
  returnRequests ReturnRequest[]

  @@unique([escrowChainId, escrowContractOrderId])
  @@index([cardPaymentId])
  @@index([buyerId, createdAt])
  @@index([sellerId, status])
  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id                 String  @id @default(cuid())
  orderId            String
  productId          String
  productVariantId   String
  titleSnapshot      String
  variantSnapshot    String
  quantity           Int
  unitPriceUsdMicros BigInt
  imageSnapshot      String?

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
}

model PaymentIntent {
  id                String       @id @default(cuid())
  orderId           String
  routeKind         RouteKind
  routeId           String
  /// checkout quote this intent was created from (idempotency key for /api/checkout/initiate)
  quoteId           String?      @unique
  payer             String
  sourceChainId     Int
  sourceToken       String
  sourceAmount      Decimal      @db.Decimal(78, 0)
  feeAmount         Decimal      @db.Decimal(78, 0)
  destChainId       Int
  destToken         String
  destAmount        Decimal      @db.Decimal(78, 0)
  destBuyer         String
  deliveryWindowSec Int
  status            IntentStatus @default(CREATED)
  /// bytes32 intent id from TrestlePaymentRouter (cross-chain) — null until IntentCreated is indexed
  onchainIntentId   String?      @unique
  onchainNonce      String?
  expiresAt         DateTime
  securityScore     Int
  estimatedSeconds  Int
  sourceTxHash      String?
  fulfillTxHash     String?
  settleTxHash      String?
  failTxHash        String?
  failureReason     String?
  escrowOrderId     String?
  /// relayer bookkeeping
  relayAttempts     Int          @default(0)
  nextAttemptAt     DateTime?
  lastError         String?
  /// ordered timeline of {status, at, txHash?, chainId?, note?}
  txHashes          Json         @default("[]")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([orderId])
}

model Dispute {
  id              String        @id @default(cuid())
  orderId         String        @unique
  raisedById      String?
  raisedByAddress String
  reason          String
  evidence        String?
  status          DisputeStatus @default(OPEN)
  buyerShareBps   Int?
  resolutionNotes String?
  resolvedById    String?
  raiseTxHash     String?
  resolveTxHash   String?
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  raisedBy   User? @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  resolvedBy User? @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
}

model Review {
  id               String   @id @default(cuid())
  /// one review per completed order
  orderId          String   @unique
  productId        String
  authorId         String
  rating           Int
  title            String?
  text             String
  verifiedPurchase Boolean  @default(true)
  createdAt        DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([productId, createdAt])
}

model ReputationEvent {
  id          String              @id @default(cuid())
  userId      String?
  address     String
  chainId     Int
  eventType   ReputationEventType
  weight      Int
  /// decayed score after the event, whole points (score / 1e18)
  newScore    Decimal             @db.Decimal(38, 6)
  /// null only for seeded demo rows (isSeedDemo) — never fabricated
  txHash      String?
  logIndex    Int?
  blockNumber BigInt?
  isSeedDemo  Boolean             @default(false)
  createdAt   DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@unique([chainId, txHash, logIndex])
  @@index([address, createdAt])
  @@index([userId, createdAt])
}

model LoyaltyTransaction {
  id         String        @id @default(cuid())
  userId     String?
  address    String
  chainId    Int
  type       LoyaltyTxType
  amount     Decimal       @db.Decimal(78, 0)
  /// null only for seeded demo rows (isSeedDemo) — never fabricated
  txHash     String?
  logIndex   Int?
  isSeedDemo Boolean       @default(false)
  createdAt  DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@unique([chainId, txHash, logIndex])
  @@index([address, createdAt])
  @@index([userId, createdAt])
}

model SupportedChain {
  chainId       Int     @id
  name          String
  rpcUrl        String
  nativeToken   String
  isTestnetDemo Boolean @default(true)
  networkMode   String
  role          String
  explorerUrl   String?
  enabled       Boolean @default(true)
}

/// Durable, de-duplicated log of every Trestle contract event the relayer/indexer has applied.
model ChainEvent {
  id          String    @id @default(cuid())
  chainId     Int
  contract    String
  address     String
  eventName   String
  txHash      String
  logIndex    Int
  blockNumber BigInt
  blockTime   DateTime?
  args        Json
  createdAt   DateTime  @default(now())

  @@unique([chainId, txHash, logIndex])
  @@index([eventName, createdAt])
  @@index([chainId, blockNumber])
}

/// Last fully-processed block per chain for the relayer's indexer.
model RelayerCheckpoint {
  id        String   @id
  chainId   Int
  lastBlock BigInt
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
}

/// Leader lease so that only one relayer instance processes intents at a time (also serves as a heartbeat).
model RelayerLease {
  id        String   @id
  holder    String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
  info      Json     @default("{}")
}

/// One hosted Stripe Checkout Session covering one or more seller orders.
/// Signed webhooks are the only thing that moves this to PAID; success URLs never do.
model CardPayment {
  id                      String            @id @default(cuid())
  userId                  String?
  status                  CardPaymentStatus @default(OPEN)
  currency                String            @default("usd")
  /// exact minor units (cents)
  subtotalCents           Int
  discountCents           Int               @default(0)
  shippingCents           Int
  totalCents              Int
  refundedCents           Int               @default(0)
  promoCode               String?
  shippingMethod          String
  email                   String?
  /// sha256 of the opaque guest access token (the token itself is never stored)
  guestAccessTokenHash    String?           @unique
  stripeCheckoutSessionId String?           @unique
  stripePaymentIntentId   String?           @unique
  stripeCouponId          String?
  /// Stripe session expiry; stock is held until the session is confirmed expired
  expiresAt               DateTime
  paidAt                  DateTime?
  stockReleased           Boolean           @default(false)
  /// shipping address as collected by Stripe Checkout
  shippingAddress         Json?
  failureReason           String?
  /// last applied Stripe event time (monotonic guard for out-of-order delivery)
  lastEventAt             DateTime?
  lines                   Json              @default("[]")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  user   User?   @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([status, expiresAt])
  @@index([userId, createdAt])
}

/// Idempotency ledger for Stripe webhook deliveries.
model StripeEvent {
  id          String    @id
  type        String
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  /// "applied" | "ignored:<reason>" | "error:<message>"
  outcome     String?
}

model PromoCode {
  id               String    @id @default(cuid())
  /// upper-cased code
  code             String    @unique
  description      String    @default("")
  percentOff       Int?
  amountOffCents   Int?
  minSubtotalCents Int       @default(0)
  active           Boolean   @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  maxRedemptions   Int?
  redemptions      Int       @default(0)
  createdAt        DateTime  @default(now())
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String
  userId      String?
  status      ReturnStatus @default(REQUESTED)
  reason      String
  notes       String?
  /// [{orderItemId, quantity}]
  items       Json
  refundCents Int?
  adminNotes  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  resolvedAt  DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([orderId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  orderRef  String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}

/// Single-use password reset tokens. Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
